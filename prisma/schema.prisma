generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  UPLOADED
  OCR_PROCESSING
  OCR_COMPLETED
  AI_PROCESSING
  REVIEW_REQUIRED
  COMPLETED
  FAILED
}

enum ResourceType {
  SOURCE_IMAGE
  OCR_JSON
  STRUCTURED_JSON
  EXCEL
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ActivityStatus {
  PUBLISHED
  ENDED
}

enum RecipientKind {
  PARTY
  TAG
  USER
}

enum NotificationKind {
  PUBLISH
  REMIND
}

enum NotificationTrigger {
  AUTO
  MANUAL
}

enum NotificationStatus {
  SENT
  FAILED
}

enum AssistantRole {
  USER
  ASSISTANT
}

enum AssistantToolStatus {
  OK
  ERROR
  DENIED
}

enum AssistantExportStatus {
  COMPLETED
  FAILED
}

enum ApplicationDecision {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  passwordHash String
  name         String?
  roleId       String?       @db.Uuid
  disabled     Boolean       @default(false)
  tasks        OcrTask[]
  templates    OcrTemplate[]
  clubs        Club[]
  imports      ImportBatch[]
  activities        Activity[]
  assistantSessions AssistantSession[]
  role              Role?              @relation(fields: [roleId], references: [id])
  createdAt    DateTime      @default(now())

  @@index([roleId])
  @@map("users")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isSuper   Boolean  @default(false)
  createdAt DateTime @default(now())

  users User[]
  menus RoleMenu[]
  clubs RoleClub[]

  @@map("roles")
}

model RoleMenu {
  roleId  String @db.Uuid
  menuKey String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, menuKey])
  @@map("role_menus")
}

model RoleClub {
  roleId String @db.Uuid
  clubId String @db.Uuid

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([roleId, clubId])
  @@map("role_clubs")
}

model Club {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  name      String
  leader    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wecomTeamId String?  @db.Uuid

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  wecomTeam     WecomTeam?     @relation(fields: [wecomTeamId], references: [id])
  members       Member[]
  imports       ImportBatch[]
  activityClubs ActivityClub[]
  attendances   ActivityAttendance[]
  roleClubs     RoleClub[]
  applications  Application[]

  @@unique([userId, name])
  @@index([userId, createdAt])
  @@map("clubs")
}

model Application {
  id         String              @id @default(uuid()) @db.Uuid
  clubId     String?             @db.Uuid
  clubName   String
  gameName   String
  score      Int
  uid        String
  reason     String
  decision   ApplicationDecision @default(PENDING)
  readAt     DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  club Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)

  @@index([clubId, readAt, createdAt])
  @@map("applications")
}

model Member {
  id             String   @id @default(uuid()) @db.Uuid
  clubId         String   @db.Uuid
  playerName     String
  rank           Int
  level          Int?
  path           String?
  score          Int?
  fashion        Int?
  weeklyActivity Int?
  joinedText     String?
  previousRank   Int?
  previousScore  Int?
  dataUpdatedAt  DateTime
  createdAt      DateTime @default(now())

  club         Club                 @relation(fields: [clubId], references: [id])
  wecomBinding WecomBinding?
  checkIns     ActivityCheckIn[]
  attendances  ActivityAttendance[]

  @@unique([clubId, playerName])
  @@index([clubId, rank])
  @@map("members")
}

model ImportBatch {
  id         String   @id @default(uuid()) @db.Uuid
  clubId     String   @db.Uuid
  userId     String?  @db.Uuid
  objectName String
  rowCount   Int
  createdAt  DateTime @default(now())

  club Club  @relation(fields: [clubId], references: [id])
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clubId, createdAt])
  @@map("import_batches")
}

model OcrTask {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  title          String
  status         TaskStatus @default(UPLOADED)
  templateId     String?    @db.Uuid
  sourceCount    Int        @default(0)
  dataVersion    Int        @default(0)
  idempotencyKey String?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user      User             @relation(fields: [userId], references: [id])
  template  OcrTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  images    OcrImage[]
  records   OcrRecord[]
  messages  AiMessage[]
  resources ResourceFile[]
  exports   ExportJob[]
  revisions RecordRevision[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@map("ocr_tasks")
}

model OcrImage {
  id             String   @id @default(uuid()) @db.Uuid
  taskId         String   @db.Uuid
  resourceId     String   @db.Uuid
  pageIndex      Int      @default(0)
  ocrText        String   @default("")
  ocrJson        Json?
  meanConfidence Float?
  createdAt      DateTime @default(now())

  task OcrTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, pageIndex])
  @@map("ocr_images")
}

model OcrRecord {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @db.Uuid
  rowIndex    Int
  productName String
  price       Decimal? @db.Decimal(12, 2)
  quantity    Decimal? @db.Decimal(12, 3)
  total       Decimal? @db.Decimal(14, 2)
  unit        String?
  confidence  Float?
  rawText     String?
  extra       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task OcrTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, rowIndex])
  @@index([taskId])
  @@map("ocr_records")
}

model RecordRevision {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  version   Int
  source    String
  snapshot  Json
  createdAt DateTime @default(now())

  task OcrTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, version])
  @@index([taskId, version])
  @@map("record_revisions")
}

model OcrTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String
  description String?
  schema      Json
  prompt      String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id])
  tasks OcrTask[]

  @@unique([userId, name])
  @@map("ocr_templates")
}

model AiMessage {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  role      String
  content   String
  createdAt DateTime @default(now())

  task OcrTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("ai_messages")
}

model ResourceFile {
  id           String       @id @default(uuid()) @db.Uuid
  taskId       String       @db.Uuid
  type         ResourceType
  objectName   String       @unique
  contentType  String
  sizeBytes    BigInt
  sha256       String
  originalName String?
  createdAt    DateTime     @default(now())

  task OcrTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, type])
  @@map("resource_files")
}

model ExportJob {
  id           String       @id @default(uuid()) @db.Uuid
  taskId       String       @db.Uuid
  status       ExportStatus @default(PENDING)
  resourceId   String?      @db.Uuid
  errorMessage String?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?

  task OcrTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("export_jobs")
}

model WecomTeam {
  id        String   @id @default(uuid()) @db.Uuid
  corpId    String   @unique
  agentId   String
  name      String   @default("企业微信团队")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubs      Club[]
  activities Activity[]
  bindings   WecomBinding[]

  @@map("wecom_teams")
}

model Activity {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String?        @db.Uuid
  wecomTeamId     String?        @db.Uuid
  title           String
  note            String?
  startsAt        DateTime
  remindAt        DateTime?
  status          ActivityStatus @default(PUBLISHED)
  publishedAt     DateTime       @default(now())
  endedAt         DateTime?
  remindClaimedAt DateTime?

  user          User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  wecomTeam     WecomTeam?             @relation(fields: [wecomTeamId], references: [id])
  clubs         ActivityClub[]
  recipients    ActivityRecipient[]
  checkIns      ActivityCheckIn[]
  notifications ActivityNotification[]
  attendances   ActivityAttendance[]

  @@index([userId, publishedAt])
  @@index([status, remindAt])
  @@map("activities")
}

model ActivityClub {
  activityId String @db.Uuid
  clubId     String @db.Uuid

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  club     Club     @relation(fields: [clubId], references: [id])

  @@id([activityId, clubId])
  @@index([clubId])
  @@map("activity_clubs")
}

model ActivityAttendance {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @db.Uuid
  memberId   String?  @db.Uuid
  clubId     String   @db.Uuid
  playerName String
  late       Boolean  @default(false)
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  member   Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([activityId, memberId])
  @@unique([activityId, clubId, playerName])
  @@index([clubId, playerName])
  @@index([memberId])
  @@map("activity_attendances")
}

model ActivityRecipient {
  activityId String        @db.Uuid
  kind       RecipientKind
  wecomId    String

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([activityId, kind, wecomId])
  @@map("activity_recipients")
}

model WecomBinding {
  id          String   @id @default(uuid()) @db.Uuid
  wecomTeamId String   @db.Uuid
  wecomUserId String
  memberId    String   @unique @db.Uuid
  createdAt   DateTime @default(now())

  wecomTeam WecomTeam @relation(fields: [wecomTeamId], references: [id])
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([wecomTeamId, wecomUserId])
  @@map("wecom_bindings")
}

model ActivityCheckIn {
  activityId  String   @db.Uuid
  memberId    String   @db.Uuid
  wecomUserId String
  checkedAt   DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([activityId, memberId])
  @@unique([activityId, wecomUserId])
  @@map("activity_check_ins")
}

model ActivityNotification {
  id             String              @id @default(uuid()) @db.Uuid
  activityId     String              @db.Uuid
  kind           NotificationKind
  trigger        NotificationTrigger
  status         NotificationStatus
  recipientCount Int
  errorMessage   String?
  createdAt      DateTime            @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, createdAt])
  @@map("activity_notifications")
}

model AssistantSession {
  id                        String   @id @default(uuid()) @db.Uuid
  userId                    String   @db.Uuid
  activeClubId              String?  @db.Uuid
  pending                   Json?
  processingClientRequestId String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]
  tools    AssistantToolCall[]
  exports  AssistantExport[]

  @@index([userId, updatedAt])
  @@map("assistant_sessions")
}

model AssistantMessage {
  id               String        @id @default(uuid()) @db.Uuid
  sessionId        String        @db.Uuid
  userId           String        @db.Uuid
  role             AssistantRole
  content          String
  scene            String?
  clientRequestId  String?
  replyToMessageId String?       @db.Uuid
  exportId         String?       @db.Uuid
  createdAt        DateTime      @default(now())

  session AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientRequestId])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@map("assistant_messages")
}

model AssistantToolCall {
  id         String              @id @default(uuid()) @db.Uuid
  sessionId  String              @db.Uuid
  userId     String              @db.Uuid
  tool       String
  clubId     String?             @db.Uuid
  status     AssistantToolStatus
  errorCode  String?
  durationMs Int
  createdAt  DateTime            @default(now())

  session AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@map("assistant_tool_calls")
}

model AssistantExport {
  id          String                @id @default(uuid()) @db.Uuid
  sessionId   String                @db.Uuid
  userId      String                @db.Uuid
  clubId      String                @db.Uuid
  clubIds     String[]              @default([])
  clubName    String
  objectName  String
  fileName    String
  memberCount Int
  status      AssistantExportStatus
  expiresAt   DateTime
  createdAt   DateTime              @default(now())

  session AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("assistant_exports")
}
