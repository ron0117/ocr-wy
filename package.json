{
  "name": "ocr-platform",
  "private": true,
  "version": "0.1.0",
  "description": "OCR 智能数据处理平台",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "prisma": "^6.6.0"
  },
  "scripts": {
    "build:types": "pnpm --filter @ocr/shared-types build",
    "dev:api": "pnpm --filter @ocr/api dev",
    "dev:web": "pnpm --filter @ocr/web dev",
    "build": "pnpm --filter @ocr/shared-types build && pnpm --filter @ocr/api build && pnpm --filter @ocr/web build",
    "check": "pnpm --filter @ocr/api check",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "pnpm --filter @ocr/api seed"
  }
}
