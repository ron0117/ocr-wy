FROM node:20-bookworm-slim AS build

ARG NPM_REGISTRY=
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN set -eux; \
    if [ -n "$NPM_REGISTRY" ]; then export COREPACK_NPM_REGISTRY="$NPM_REGISTRY"; fi; \
    corepack enable && corepack prepare pnpm@10.18.0 --activate; \
    if [ -n "$NPM_REGISTRY" ]; then pnpm config set registry "$NPM_REGISTRY"; fi

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
COPY packages/guide-types/package.json packages/guide-types/package.json
RUN pnpm install --frozen-lockfile

COPY apps/api apps/api
COPY packages/shared-types packages/shared-types
COPY packages/guide-types packages/guide-types
COPY prisma prisma
RUN pnpm --filter @ocr/api build

FROM node:20-bookworm-slim AS runtime

ARG APT_MIRROR=
ARG NPM_REGISTRY=
ENV NODE_ENV=production
ENV npm_config_verify_deps_before_run=false
ENV PRISMA_BINARIES_MIRROR=https://registry.npmmirror.com/-/binary/prisma
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN set -eux; \
    if [ -n "$NPM_REGISTRY" ]; then export COREPACK_NPM_REGISTRY="$NPM_REGISTRY"; fi; \
    corepack enable && corepack prepare pnpm@10.18.0 --activate; \
    if [ -n "$APT_MIRROR" ]; then \
      for f in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
        [ -f "$f" ] || continue; \
        sed -i \
          -e "s|http://deb.debian.org|$APT_MIRROR|g" \
          -e "s|http://security.debian.org|$APT_MIRROR|g" \
          "$f"; \
      done; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/packages/shared-types ./packages/shared-types
COPY --from=build /app/packages/guide-types ./packages/guide-types
COPY --from=build /app/prisma ./prisma
COPY deploy/api-entrypoint.sh /usr/local/bin/api-entrypoint
RUN chmod +x /usr/local/bin/api-entrypoint \
    && touch /app/.env \
    && mkdir -p /app/data/storage \
    && chown -R node:node /app/data /app/.env

EXPOSE 3000
ENTRYPOINT ["api-entrypoint"]
CMD ["node", "apps/api/dist/main.js"]
