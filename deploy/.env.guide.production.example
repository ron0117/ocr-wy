# 复制为项目根目录 .env.guide.production
# 部署：docker compose --env-file .env.guide.production -f docker-compose.guide.yml up -d --build

GUIDE_POSTGRES_USER=guide
GUIDE_POSTGRES_PASSWORD=change-me
GUIDE_POSTGRES_DB=guide

# 浏览器访问来源（CORS）
GUIDE_WEB_ORIGIN=https://wiki.wuyouclub.online

# 首次部署可 true：migrate 后自动 guide:import（镜像内已含 apps/guide-api/data）
SEED_GUIDE=true

# --- 部署模式（与 .env.production 保持一致）---
DEPLOY_DUAL_HOST=true

# wiki 域名（宿主机 certbot SAN、记录用）
GUIDE_CERTBOT_DOMAIN=wiki.wuyouclub.online
CERTBOT_EMAIL=admin@example.com

# Guide 容器内 TLS：双站填 none；容器自带 8443 时不要设此项
GUIDE_CONTAINER_CERTBOT_DOMAIN=none

# Docker 端口映射。双站默认回环 9081，公网 443 由宿主机 Nginx 反代
GUIDE_PUBLISH_HTTP=127.0.0.1:9081:80
GUIDE_PUBLISH_HTTPS=127.0.0.1:19081:443

# 非双站 / 调试：容器直接暴露端口（未设 GUIDE_PUBLISH_* 时 compose 用下面两项）
GUIDE_HTTP_PORT=8080
GUIDE_HTTPS_PORT=8443

# 可选构建加速
# NPM_REGISTRY=https://registry.npmmirror.com
# APT_MIRROR=https://mirrors.aliyun.com
