FROM node:20-bookworm-slim AS build

ARG NPM_REGISTRY=
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN set -eux; \
    if [ -n "$NPM_REGISTRY" ]; then export COREPACK_NPM_REGISTRY="$NPM_REGISTRY"; fi; \
    corepack enable && corepack prepare pnpm@10.18.0 --activate; \
    if [ -n "$NPM_REGISTRY" ]; then pnpm config set registry "$NPM_REGISTRY"; fi

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/guide-api/package.json apps/guide-api/package.json
COPY packages/guide-types/package.json packages/guide-types/package.json
RUN pnpm install --frozen-lockfile

COPY apps/guide-api apps/guide-api
RUN mkdir -p apps/guide-api/data
COPY apps/guide/data/puppets/秘偶图鉴.md apps/guide-api/data/puppets/秘偶图鉴.md
COPY packages/guide-types packages/guide-types
COPY prisma/guide prisma/guide
COPY scripts/guide-import.ts scripts/guide-import.ts
COPY scripts/load-guide-env.ts scripts/load-guide-env.ts
RUN rm -rf apps/guide-api/src/generated \
    && pnpm exec prisma generate --schema prisma/guide/schema.prisma \
    && pnpm --filter @ocr/guide-api build

FROM node:20-bookworm-slim AS runtime

ARG APT_MIRROR=
ARG NPM_REGISTRY=
ENV NODE_ENV=production
ENV npm_config_verify_deps_before_run=false
ENV PRISMA_BINARIES_MIRROR=https://registry.npmmirror.com/-/binary/prisma
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN set -eux; \
    if [ -n "$NPM_REGISTRY" ]; then export COREPACK_NPM_REGISTRY="$NPM_REGISTRY"; fi; \
    corepack enable && corepack prepare pnpm@10.18.0 --activate; \
    if [ -n "$APT_MIRROR" ]; then \
      for f in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
        [ -f "$f" ] || continue; \
        sed -i \
          -e "s|http://deb.debian.org|$APT_MIRROR|g" \
          -e "s|http://security.debian.org|$APT_MIRROR|g" \
          "$f"; \
      done; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/apps/guide-api/package.json ./apps/guide-api/package.json
COPY --from=build /app/apps/guide-api/node_modules ./apps/guide-api/node_modules
COPY --from=build /app/apps/guide-api/dist ./apps/guide-api/dist
COPY --from=build /app/apps/guide-api/data ./apps/guide-api/data
COPY --from=build /app/apps/guide-api/src/generated ./apps/guide-api/src/generated
COPY --from=build /app/apps/guide-api/dist/generated ./apps/guide-api/dist/generated
COPY --from=build /app/packages/guide-types ./packages/guide-types
COPY --from=build /app/prisma/guide ./prisma/guide
COPY --from=build /app/scripts/guide-import.ts ./scripts/guide-import.ts
COPY --from=build /app/scripts/load-guide-env.ts ./scripts/load-guide-env.ts
COPY deploy/guide-api-entrypoint.sh /usr/local/bin/guide-api-entrypoint
RUN chmod +x /usr/local/bin/guide-api-entrypoint \
    && touch /app/.env

EXPOSE 3001
ENTRYPOINT ["guide-api-entrypoint"]
CMD ["node", "apps/guide-api/dist/main.js"]
