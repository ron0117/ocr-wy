# 宿主机唯一 Nginx：按子域反代 OCR（识单）与 Guide（wiki）
#
# 用法概要：
# 0. 复制 deploy/nginx.00-performance.conf → /etc/nginx/conf.d/00-performance.conf
# 1. 两个 compose 只监听本机回环（见 docker-compose.host-proxy.*.yml）
# 2. 本文件复制到 /etc/nginx/conf.d/wuyouclub-dual.conf（或 sites-enabled）
# 3. certbot --nginx -d wuyouclub.online -d wiki.wuyouclub.online（或分两次签）
# 4. 腾讯云 CDN：两个加速域名源站均指向本机公网 IP:443，并回源 Host 为客户端域名（默认即可）
#
# 替换 __OCR_UPSTREAM__ / __GUIDE_UPSTREAM__ 为实际 upstream（默认 127.0.0.1:9080 / 9081）

upstream ocr_web {
    server 127.0.0.1:9080;
    keepalive 8;
}

upstream guide_wiki {
    server 127.0.0.1:9081;
    keepalive 8;
}

# 80：EdgeOne/CDN 常用 HTTP 回源，此处必须反代，不能 301 到 https（否则边缘 HTTPS + 源站 301 会死循环，/_next 等静态资源全挂）
server {
    listen 80;
    server_name __MAIN_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://ocr_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}

server {
    listen 80;
    server_name __WIKI_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://guide_wiki;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
    }
}

server {
    listen 443 ssl;
    server_name __MAIN_DOMAIN__;
    client_max_body_size 30m;

    ssl_certificate     /etc/letsencrypt/live/__CERT_PRIMARY__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_PRIMARY__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    location / {
        proxy_pass http://ocr_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}

server {
    listen 443 ssl;
    server_name __WIKI_DOMAIN__;
    client_max_body_size 512k;

    # 与主站共用一张 SAN 证（certbot -d 主域 -d wiki）时路径与主站相同
    ssl_certificate     /etc/letsencrypt/live/__CERT_PRIMARY__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_PRIMARY__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    location / {
        proxy_pass http://guide_wiki;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
    }
}
