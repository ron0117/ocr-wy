# 复制为项目根目录 .env.production。bootstrap-centos.sh 首次运行会自动生成强密码。
POSTGRES_USER=ocr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ocr
JWT_SECRET=change-me

# API 首次启动时，若该邮箱尚不存在，会用这个密码创建超级管理员
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=Admin123456

# 浏览器/API CORS 主站地址（双站由宿主机 Nginx 提供 HTTPS）
WEB_ORIGIN=https://wuyouclub.online

# Wiki 内容管理（识单 api 容器经 Docker 网 ocr_guide_internal 访问 guide-api:3001）
GUIDE_API_URL=http://guide-api:3001
# 与 .env.guide.production 中 GUIDE_ADMIN_TOKEN 保持一致
GUIDE_ADMIN_TOKEN=change-me-long-random

# 可选：public 活动页媒体走腾讯云 COS（桶：私有写 + 公有读）
# 本机上传：pnpm upload:public-cos --write-env && 再部署 web
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=ap-shanghai
# COS_PUBLIC_BASE_URL=https://guide.wuyouclub.online
# COS_KEY_PREFIX=
# VITE_PUBLIC_ASSET_CDN=https://你的CDN域名
# VITE_PUBLIC_ASSET_OMIT_LOCAL=true

# --- 部署模式 ---
# true：bootstrap-centos.sh 转 deploy/bootstrap-dual-host-centos.sh（同机 wiki + 宿主机 Nginx）
DEPLOY_DUAL_HOST=true

# 主站域名（宿主机 certbot、记录用；勿删）
CERTBOT_DOMAIN=wuyouclub.online
CERTBOT_EMAIL=admin@example.com

# 识单容器内 TLS：双站填 none；单容器 80/443 时不要设此项（compose 回退 CERTBOT_DOMAIN）
OCR_CONTAINER_CERTBOT_DOMAIN=none

# Docker 端口映射（compose 读取）。双站默认只绑回环，公网 80/443 给宿主机 Nginx
OCR_PUBLISH_HTTP=127.0.0.1:9080:80
OCR_PUBLISH_HTTPS=127.0.0.1:19080:443

# 单容器自建 TLS 时使用（DEPLOY_DUAL_HOST=false 且未设 OCR_PUBLISH_* 时生效）
HTTP_PORT=80
HTTPS_PORT=443

# 可选：OpenAI 兼容接口（必须以 /v1 结尾）
AI_BASE_URL=http://host.docker.internal:48760/v1
AI_API_KEY=
AI_MODEL=

# true 会创建 README 中的演示账号；正式环境建议保持 false
SEED_DATABASE=false
