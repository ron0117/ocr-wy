# 复制为项目根目录 .env.production。bootstrap-centos.sh 首次运行会自动生成强密码。
POSTGRES_USER=ocr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ocr
JWT_SECRET=change-me
OCR_AUTH_TOKEN=change-me

# API 首次启动时，若该邮箱尚不存在，会用这个密码创建超级管理员
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=Admin123456

# 域名已解析时写 https://域名；暂时没有域名可写 http://服务器IP
WEB_ORIGIN=http://127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443

# 填写已解析到本机的域名后，部署脚本会用 Let's Encrypt 申请证书，并把 WEB_ORIGIN 改为 https
CERTBOT_DOMAIN=wuyouclub.online
CERTBOT_EMAIL=admin@example.com

# 可选：OpenAI 兼容接口（必须以 /v1 结尾）
AI_BASE_URL=http://host.docker.internal:48760/v1
AI_API_KEY=
AI_MODEL=

# true 会创建 README 中的演示账号；正式环境建议保持 false
SEED_DATABASE=false

