# 复制为项目根目录 .env.production。bootstrap-centos.sh 首次运行会自动生成强密码。
POSTGRES_USER=ocr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ocr
JWT_SECRET=change-me

# API 首次启动时，若该邮箱尚不存在，会用这个密码创建超级管理员
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=Admin123456

# 首次部署先写 HTTP 地址。证书申请成功后，脚本会改成 https://wuyouclub.online
WEB_ORIGIN=http://127.0.0.1

# 可选：public 活动页媒体走腾讯云 COS（桶：私有写 + 公有读）
# 本机上传：pnpm upload:public-cos --write-env && 再部署 web
# COS_SECRET_ID=AKIDpwwk2A7uXyGONex53qRr6A4mJMDsKemm
# COS_SECRET_KEY=77zfQCq7ZpvqZCoGXcZM0Ut9YwFRcdTA
# COS_BUCKET=guide-1503889614
# COS_REGION=ap-shanghai
# COS_PUBLIC_BASE_URL=https://guide.wuyouclub.online
# COS_KEY_PREFIX=
# 上传脚本会写入或手动设置：
# VITE_PUBLIC_ASSET_CDN=https://你的CDN域名
# VITE_PUBLIC_ASSET_OMIT_LOCAL=true
HTTP_PORT=80
HTTPS_PORT=443

# 证书申请使用 80 端口校验，成功后站点监听 443 并跳转到 HTTPS
CERTBOT_DOMAIN=wuyouclub.online
CERTBOT_EMAIL=admin@example.com

# 可选：OpenAI 兼容接口（必须以 /v1 结尾）
AI_BASE_URL=http://host.docker.internal:48760/v1
AI_API_KEY=
AI_MODEL=

# true 会创建 README 中的演示账号；正式环境建议保持 false
SEED_DATABASE=false

