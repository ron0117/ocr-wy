DATABASE_URL="postgresql://ocr:ocr@localhost:5432/ocr?schema=public"
PORT=3000
WEB_ORIGIN="http://localhost:5173"
JWT_SECRET="replace-with-a-long-random-secret"

# local：文件落在仓库 data/storage；gcs：私有桶，依赖 Application Default Credentials
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="../../data/storage"
GCS_BUCKET=""
GCS_PUBLIC_CDN_BASE=""

OCR_SERVICE_URL="http://127.0.0.1:8000"
OCR_AUTH_TOKEN=""

# OpenAI 兼容接口，须以 /v1 结尾。导入人员时用它把 OCR 文字整理成人员行。
# AI_MODEL 留空时使用该服务模型列表中的第一个。密钥不要写入前端。
AI_BASE_URL="http://127.0.0.1:48760/v1"
AI_API_KEY=""
AI_MODEL=""
