DATABASE_URL="postgresql://ocr:ocr@localhost:5432/ocr?schema=public"
# Guide /wiki 独立库（Prisma schema: prisma/guide）
GUIDE_DATABASE_URL="postgresql://ocr:ocr@localhost:5432/guide?schema=public"
PORT=3000
WEB_ORIGIN="http://localhost:5777"
JWT_SECRET="replace-with-a-long-random-secret"

# 预置超级管理员。密码只在该邮箱还不存在时写入，不要提交真实密码。
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="replace-with-at-least-8-chars"

# local：文件落在仓库 data/storage；gcs：私有桶，依赖 Application Default Credentials
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="../../data/storage"
GCS_BUCKET=""
GCS_PUBLIC_CDN_BASE=""

# OpenAI 兼容接口，须以 /v1 结尾。导入人员时用它直接读截图。
# AI_MODEL 留空时使用该服务模型列表中的第一个。密钥不要写入前端。
AI_BASE_URL="http://127.0.0.1:48760/v1"
AI_API_KEY=""
AI_MODEL=""

# OCR 后台管理 Wiki：与 guide-api 的 GUIDE_ADMIN_TOKEN 保持一致
GUIDE_API_URL="http://127.0.0.1:3001"
GUIDE_ADMIN_TOKEN=""
