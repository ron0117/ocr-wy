{
  "name": "@ocr/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @ocr/shared-types build && pnpm --dir ../.. exec prisma generate --schema prisma/schema.prisma",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @ocr/shared-types build && pnpm --dir ../.. exec prisma generate --schema prisma/schema.prisma",
    "build": "nest build",
    "start": "node dist/main.js",
    "seed": "tsx ../../prisma/seed.ts",
    "check": "tsx src/scripts/self-check.ts",
    "test:members": "tsx --test src/members/parse-member-table.test.ts src/members/structure-members.test.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.16.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^12.0.2",
    "@ocr/shared-types": "workspace:*",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.5.0",
    "multer": "^2.0.2",
    "openai": "^4.91.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
