# 复制为项目根目录 .env.guide.production
# 部署：docker compose --env-file .env.guide.production -f docker-compose.guide.yml up -d --build

GUIDE_POSTGRES_USER=guide
GUIDE_POSTGRES_PASSWORD=change-me
GUIDE_POSTGRES_DB=guide

# 浏览器访问来源（CORS）
GUIDE_WEB_ORIGIN=https://wiki.wuyouclub.online

# 首次部署可 true：migrate 后自动 guide:import（镜像内已含 data + docs/游戏资料）
SEED_GUIDE=true

# 与 OCR 同机时默认 8080/8443，避免占用识单 80/443；wiki DNS 指向本机后：
# - 方案 A：改用 GUIDE_HTTP_PORT=80 GUIDE_HTTPS_PORT=443（需 OCR 不占端口或分机器）
# - 方案 B：前置 CDN/负载均衡把 wiki 子域转到 8443
GUIDE_HTTP_PORT=8080
GUIDE_HTTPS_PORT=8443

# Let's Encrypt（证书就绪后 guide-proxy 自动切换 HTTPS 配置）
GUIDE_CERTBOT_DOMAIN=wiki.wuyouclub.online
CERTBOT_EMAIL=admin@example.com

# 可选构建加速
# NPM_REGISTRY=https://registry.npmmirror.com
# APT_MIRROR=https://mirrors.aliyun.com
